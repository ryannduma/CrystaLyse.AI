# Include documentation
include README.md
include LICENSE
include CHANGELOG.md

# Include configuration files
include pyproject.toml

# Include prompt templates
recursive-include src/crystalyse/prompts *.md *.txt

# Exclude development files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store

# Exclude test files
recursive-exclude src/crystalyse/tests *
recursive-exclude tests *

# Exclude cache directories.
#
# Do NOT re-add ``prune src/crystalyse/workspace`` here: that line was the
# root cause of issue #31 (ModuleNotFoundError: No module named
# 'crystalyse.workspace'). The ``workspace`` subpackage hosts the per-project
# filesystem tools (read_file, write_file, list_files) that the agent
# registers via the OpenAI Agents SDK — it must be shipped in every release.
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache

# Exclude egg-info directories
global-exclude *.egg-info
